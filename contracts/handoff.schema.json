{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "title": "Agent Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "work_item_id", "from", "to", "created_at", "status", "summary", "artifacts", "decisions", "open_questions", "risks", "evidence", "memory_delta", "next_gate", "acceptance", "acknowledgement"],
  "properties": {
    "id": {"type": "string", "pattern": "^HANDOFF-[A-Z0-9-]+$"},
    "work_item_id": {"type": "string", "pattern": "^(EPIC|US|TASK|BUG|REL|EVOL|STUDY|SPIKE)-[A-Z0-9-]+$"},
    "from": {"type": "string", "minLength": 2},
    "to": {"type": "string", "minLength": 2},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready", "blocked", "changes_requested", "conditionally_approved"]},
    "summary": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "memory_delta": {"type": "string", "pattern": "^memory/deltas/MEM-[A-Z0-9-]+\\.yaml$"},
    "next_gate": {"type": ["string", "null"]},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria_checked", "recipient_ack_required"],
      "properties": {
        "criteria_checked": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "recipient_ack_required": {"const": true}
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "acknowledged_by"],
      "properties": {
        "status": {"enum": ["pending", "accepted", "rejected"]},
        "acknowledged_by": {"type": "string", "minLength": 1},
        "acknowledged_at": {"type": ["string", "null"], "format": "date-time"},
        "note": {"type": "string"}
      }
    }
  }
}
