{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "title": "Agent Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "work_item_id", "from", "to", "created_at", "status", "summary", "artifacts", "decisions", "open_questions", "risks", "evidence", "memory_delta", "next_gate", "acceptance", "acknowledgement", "sod_snapshot"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^HANDOFF-[A-Z0-9-]+$"},
    "work_item_id": {"type": "string", "pattern": "^(EPIC|US|TASK|BUG|REL|EVOL|STUDY|SPIKE|INCIDENT)-[A-Z0-9-]+$"},
    "from": {"type": "string", "minLength": 2},
    "to": {"type": "string", "minLength": 2},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready", "blocked", "changes_requested", "conditionally_approved"]},
    "summary": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "memory_delta": {
      "oneOf": [
        {"type": "string", "pattern": "^memory/deltas/MEM-[A-Z0-9-]+\\.yaml$"},
        {"type": "string", "pattern": "^MEM-[A-Z0-9-]+$"},
        {"type": "integer"},
        {"type": "null"}
      ]
    },
    "next_gate": {"type": ["string", "null"]},
    "sod_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "author", "reviewer", "approver", "executor"],
      "properties": {
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "author": {"type": "string", "minLength": 2},
        "reviewer": {"type": ["string", "null"]},
        "approver": {"type": ["string", "null"]},
        "executor": {"type": ["string", "null"]},
        "independence_checked": {"type": "boolean"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria_checked", "recipient_ack_required"],
      "properties": {
        "criteria_checked": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "recipient_ack_required": {"const": true}
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "accepted", "rejected"]},
        "acknowledged_by": {"type": "string", "minLength": 1},
        "acknowledged_at": {"type": ["string", "null"], "format": "date-time"},
        "note": {"type": "string"},
        "by": {"type": ["string", "null"]},
        "at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
