{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-squad.local/contracts/disposition.schema.json",
  "title": "Source artifact disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["disposition_id", "source_item_id", "source_type", "state", "decision", "reason", "capabilities", "runtime_targets", "risks", "evidence_refs", "author", "review", "recorded_at", "provenance"],
  "properties": {
    "disposition_id": {"type": "string", "pattern": "^DISP-[A-Z0-9-]+-[0-9]{4}$"},
    "source_item_id": {"type": "string", "pattern": "^XSQ-[A-Fa-f0-9]{7,40}-(SQUAD|PERSONA|TASK|WORKFLOW|CHECKLIST|DATA|CONFIG)-[0-9]{4}$"},
    "source_type": {"enum": ["squad", "persona", "task", "workflow", "checklist", "data", "config"]},
    "state": {"enum": ["source", "adapt", "fuse", "reject", "proposed", "promoted"]},
    "decision": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "runtime_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "author": {"type": "string", "minLength": 2},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "reviewer", "evidence_refs"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_started", "changes_requested", "accepted", "rejected"]},
        "reviewer": {"type": ["string", "null"], "minLength": 2},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_refs", "input_hashes"],
      "properties": {
        "kind": {"enum": ["source", "adapted", "generated", "native"]},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "input_hashes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"}}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "promoted"}}}, "then": {"properties": {"review": {"properties": {"status": {"const": "accepted"}, "reviewer": {"type": "string", "minLength": 2}}}, "runtime_targets": {"minItems": 1}}}},
    {"if": {"properties": {"state": {"const": "reject"}}}, "then": {"properties": {"runtime_targets": {"maxItems": 0}}}}
  ]
}
