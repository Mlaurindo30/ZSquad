{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-squad.local/contracts/squad.schema.json",
  "title": "Governed runtime squad",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "state", "enabled", "mission", "virtual_chief", "primary_members", "secondary_members", "routing", "composition", "quality", "workflows", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 2},
    "version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["source", "adapt", "fuse", "reject", "proposed", "promoted"]},
    "enabled": {"type": "boolean"},
    "mission": {"type": "string", "minLength": 10},
    "virtual_chief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "persona", "persona_state"],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-chief$"},
        "persona": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "persona_state": {"enum": ["existing", "proposed", "promoted"]}
      }
    },
    "primary_members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "secondary_members": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "intents", "keywords", "not_for", "tie_breakers", "allowed_next_squads"],
      "properties": {
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "intents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "keywords": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "not_for": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tie_breakers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "allowed_next_squads": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wip_limit", "one_active_chief", "author_cannot_approve_own_artifact", "risk_high_or_critical_total"],
      "properties": {
        "wip_limit": {"type": "integer", "minimum": 1, "maximum": 10},
        "one_active_chief": {"const": true},
        "author_cannot_approve_own_artifact": {"const": true},
        "risk_high_or_critical_total": {"const": 1}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_inputs", "required_outputs", "independent_review_by", "prohibited_actions"],
      "properties": {
        "required_inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "independent_review_by": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "workflows": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_refs", "disposition_refs", "generated_from"],
      "properties": {
        "kind": {"enum": ["adapted", "generated", "native"]},
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "disposition_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "generated_from": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"state": {"not": {"const": "promoted"}}}}, "then": {"properties": {"enabled": {"const": false}}}},
    {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"state": {"const": "promoted"}, "virtual_chief": {"properties": {"persona_state": {"const": "promoted"}}}}}}
  ]
}
