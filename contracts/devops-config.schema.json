{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devops-config.schema.json",
  "title": "DevOps Board Integration Config",
  "description": "Marcador por projeto que aponta para uma organização/projeto Azure DevOps (ou outro provider) sem hardcode em código compartilhado. Vive em <project_root>/.agents_squad/config/devops.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "org_url", "project", "process_template", "work_item_type_map", "state_map"],
  "properties": {
    "provider": {"description": "azure-devops is the only currently supported provider; github and jira are planned for future sprints", "enum": ["azure-devops", "jira", "github"]},
    "org_url": {"type": "string", "pattern": "^https://(dev\\.azure\\.com/[^/]+|[^./]+\\.visualstudio\\.com)$"},
    "project": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "process_template": {"enum": ["agile", "scrum", "basic", "cmmi"]},
    "area_path": {"type": "string"},
    "iteration_path": {"type": "string"},
    "work_item_type_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic", "story", "task", "bug"],
      "properties": {
        "epic": {"type": "string", "minLength": 1},
        "story": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "bug": {"type": "string", "minLength": 1},
        "spike": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "evolution": {"type": "string", "minLength": 1},
        "study": {"type": "string", "minLength": 1}
      }
    },
    "state_map": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "required": ["blueprint", "scaffolding", "implementation", "code-security-review", "quality-validation", "governance-release", "done"],
      "properties": {
        "blueprint": {"type": "string", "minLength": 1},
        "scaffolding": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "code-security-review": {"type": "string", "minLength": 1},
        "quality-validation": {"type": "string", "minLength": 1},
        "governance-release": {"type": "string", "minLength": 1},
        "done": {"type": "string", "minLength": 1}
      }
    },
    "phase_tags": {
      "type": "object",
      "description": "US-1 (2026-09-02): tags de fase aplicadas pelo connector ao mover estado. Usadas em swimlanes do board e em queries Analytics.",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "squad_tags": {
      "type": "object",
      "description": "US-1 (2026-09-02): tags de squad temática para swimlanes por squad no board.",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "queries": {
      "type": "object",
      "description": "US-2 (2026-09-02): queries salvas em pasta Shared/Agents Squad.",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "folder": {"type": "string", "minLength": 1}
      }
    },
    "analytics": {
      "type": "object",
      "description": "US-4 (2026-09-02): URL base do Analytics OData.",
      "additionalProperties": false,
      "properties": {
        "base_url": {"type": "string", "minLength": 1}
      }
    },
    "delivery_plan": {
      "type": "object",
      "description": "US-3 (2026-09-02): Delivery Plans cross-team — opt-in.",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "dashboards": {
      "type": "object",
      "description": "US-5 (2026-09-02): Dashboards — opt-in.",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "scope": {"enum": ["project", "project_Team"]},
              "widgets": {"type": "array"}
            }
          }
        }
      }
    },
    "wiki": {
      "type": "object",
      "description": "US-6 (2026-09-02): Project wiki — opt-in.",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "slug": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "pr_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_reviewers": {"type": "integer", "minimum": 0},
        "require_linked_work_item": {"type": "boolean"},
        "target_branch": {"type": "string"},
        "creator_vote_counts": {"type": "boolean"},
        "reset_on_source_push": {"type": "boolean"},
        "block_last_pusher": {"type": "boolean"}
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_master", "development_team", "pr_and_card_approver"],
      "properties": {
        "human_master": {"$ref": "#/$defs/identity"},
        "development_team": {"$ref": "#/$defs/identity"},
        "pr_and_card_approver": {"$ref": "#/$defs/identity"}
      }
    },
    "service_accounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cyber_red": {
          "type": "object",
          "additionalProperties": false,
          "required": ["email", "purpose", "role", "permissions", "scope_paths", "used_by"],
          "properties": {
            "email": {"type": "string", "format": "email"},
            "purpose": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1},
            "permissions": {"type": "array", "items": {"type": "string"}},
            "scope_paths": {"type": "array", "items": {"type": "string"}},
            "used_by": {"type": "array", "items": {"type": "string"}},
            "double_signoff_with": {"type": "array", "items": {"type": "string"}},
            "notifications": {"type": "boolean"}
          }
        },
        "customer_data_pii": {
          "type": "object",
          "additionalProperties": false,
          "required": ["email", "purpose", "role", "permissions", "scope_paths"],
          "properties": {
            "email": {"type": "string", "format": "email"},
            "purpose": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1},
            "permissions": {"type": "array", "items": {"type": "string"}},
            "scope_paths": {"type": "array", "items": {"type": "string"}},
            "used_by": {"type": "array", "items": {"type": "string"}},
            "notifications": {"type": "boolean"},
            "segregation": {"type": "string"}
          }
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pull_request_agent": {"type": "string", "minLength": 1},
        "card_agent": {"type": "string", "minLength": 1},
        "security_collaborator": {"type": "string", "minLength": 1},
        "human_gates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "story_points": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "allowed", "max"],
          "properties": {
            "field": {"type": "string", "minLength": 1},
            "allowed": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "integer", "exclusiveMinimum": 0}
            },
            "max": {"type": "integer", "minimum": 1},
            "split_rule": {"enum": ["mandatory", "advisory"]}
          }
        },
        "epic_tshirt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "map"],
          "properties": {
            "field": {"type": "string", "minLength": 1},
            "map": {
              "type": "object",
              "additionalProperties": {"type": "number"},
              "minProperties": 1
            }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_item_types": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"}
        },
        "tags": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"}
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enable_epic_backlog": {"type": "boolean"},
        "bugs_behavior": {"enum": ["asTasks", "asRequirements", "off"]},
        "include_area_children": {"type": "boolean"},
        "apply_custom_card_rules": {"type": "boolean"},
        "wip": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "swimlanes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "query"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "query": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route_to": {"enum": ["development_team", "pr_and_card_approver", "human_master"]},
        "opt_out_human_master": {"type": "boolean"},
        "events": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "iterations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "start": {"type": "string"},
          "finish": {"type": "string"}
        }
      }
    },
    "teams": {
      "type": "array",
      "description": "Times adicionais além do time default do projeto. Cada entry gera POST /_apis/projects/{projectId}/teams.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        }
      }
    },
    "security": {
      "type": "object",
      "description": "Security ACLs via POST /_apis/accesscontrollists/{namespaceId}. Opt-in (default OFF).",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "acls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "namespaceId", "entries"],
            "properties": {
              "namespace": {"type": "string", "minLength": 1},
              "namespaceId": {"type": "string", "minLength": 36},
              "token": {"type": "string"},
              "inherit": {"type": "boolean"},
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["descriptor", "allow"],
                  "properties": {
                    "descriptor": {"type": "string", "minLength": 1},
                    "allow": {"type": "array", "items": {"type": "integer"}},
                    "deny": {"type": "array", "items": {"type": "integer"}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "service_connections": {
      "type": "array",
      "description": "Service connections para CI/CD, container registries e Kubernetes. POST /_apis/serviceEndpoints.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["azure_rm", "github", "docker_registry", "kubernetes"]},
          "service_account": {"type": "string"},
          "scope": {"type": "object", "additionalProperties": true},
          "auth": {"type": "object", "additionalProperties": true}
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "role"],
      "properties": {
        "email": {"type": "string", "minLength": 3},
        "role": {"enum": ["project-admin", "contributors", "required-reviewer"]},
        "notifications": {"type": "boolean"},
        "used_by": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
