{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-squad.local/contracts/route.schema.json",
  "title": "Persisted squad route",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_id", "work_item_id", "schema_version", "catalog_version", "state", "router", "created_at", "updated_at", "request_fingerprint", "normalized_intent", "risk", "mode", "candidates", "confidence", "confidence_band", "facts", "assumptions", "out_of_scope", "disambiguation", "selected_squad", "chain", "reroutes", "authorization", "source_refs", "routing_verdict_ref"],
  "properties": {
    "route_id": {"type": "string", "pattern": "^ROUTE-[A-Z0-9-]+-[0-9]{3}$"},
    "work_item_id": {"type": "string", "pattern": "^(EPIC|US|TASK|BUG|REL|EVOL|STUDY|SPIKE)-[A-Z0-9][A-Z0-9-]*$"},
    "schema_version": {"const": 1},
    "catalog_version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["diagnosing", "awaiting_disambiguation", "routed", "chief_selecting", "executing_link", "checkpointed", "routing_review", "completed", "no_squad_match", "needs_human_route", "changes_requested", "blocked", "cancelled"]},
    "router": {"type": "string", "minLength": 2},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "request_fingerprint": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "normalized_intent": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "mode": {"enum": ["consult", "light", "full"]},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["squad_id", "score", "score_breakdown", "penalties", "matched_rules"],
        "properties": {
          "squad_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "score": {"type": "integer", "minimum": 0, "maximum": 100},
          "score_breakdown": {"type": "object", "additionalProperties": {"type": "integer"}},
          "penalties": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "matched_rules": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "confidence_band": {"enum": ["low", "medium", "high"]},
    "facts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "disambiguation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions_asked", "question", "answer"],
      "properties": {
        "questions_asked": {"type": "integer", "minimum": 0, "maximum": 1},
        "question": {"type": ["string", "null"]},
        "answer": {"type": ["string", "null"]}
      }
    },
    "selected_squad": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_links", "current_link", "links"],
      "properties": {
        "maximum_links": {"const": 5},
        "current_link": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "links": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "squad_id", "status", "chief_persona", "selected_personas", "briefing_ref", "checkpoint_ref"],
            "properties": {
              "index": {"type": "integer", "minimum": 1, "maximum": 5},
              "squad_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["pending", "active", "checkpointed", "blocked", "cancelled"]},
              "chief_persona": {"type": ["string", "null"]},
              "selected_personas": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "briefing_ref": {"type": ["string", "null"]},
              "checkpoint_ref": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "reroutes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "reason", "recorded_at"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "reason": {"type": "string", "minLength": 1}, "recorded_at": {"type": "string", "format": "date-time"}}}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["required", "reference", "blocked_reason"], "properties": {"required": {"type": "boolean"}, "reference": {"type": ["string", "null"]}, "blocked_reason": {"type": ["string", "null"]}}},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "routing_verdict_ref": {"type": ["string", "null"]}
  }
}
