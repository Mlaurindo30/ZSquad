{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agentic-sdlc/contracts/gate-decision.schema.json",
  "title": "Gate Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "gate_id", "work_item_id", "decision", "decider", "criteria", "evidence", "human_approval", "decided_at"],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^GD-[A-Z0-9-]+$"},
    "gate_id": {"enum": ["G1-product", "G2-design", "G3-readiness", "G4-code-security", "G5-quality", "G6-governance-release"]},
    "work_item_id": {"type": "string"},
    "decision": {"enum": ["approved", "conditionally_approved", "changes_requested", "rejected", "blocked"]},
    "decider": {"type": "string"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": {"type": "string"},
          "result": {"enum": ["pass", "fail", "not_applicable"]},
          "note": {"type": "string"}
        }
      }
    },
    "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "approved_by", "evidence"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "approved"]},
        "approved_by": {"type": ["string", "null"]},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "conditions": {"type": "array", "items": {"type": "string"}},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "decided_at": {"type": "string", "format": "date-time"}
  }
}
