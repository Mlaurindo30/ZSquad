{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-item.schema.json",
  "title": "Work Item Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "state", "risk", "owner", "active_agents", "next_action", "artifacts"],
  "properties": {
    "id": {"type": "string", "pattern": "^(EPIC|US|TASK|BUG|REL|EVOL|STUDY|SPIKE)-[A-Z0-9-]+$"},
    "type": {"enum": ["epic", "story", "task", "bug", "release", "evolution", "study", "spike"]},
    "state": {"enum": ["blueprint", "scaffolding", "implementation", "code-security-review", "quality-validation", "governance-release", "done", "intake", "discovery", "product-ready", "design", "design-ready", "ready-for-build", "review", "validation", "documentation", "ready-for-release", "triage", "mitigation", "postmortem"]},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "story_points": {"enum": [1, 2, 3, 5, 8]},
    "t_shirt_size": {"enum": ["PP", "P", "M", "G", "GG"]},
    "mode": {"description": "consult=read-only, light=1 persona no gate, full=gates G1-G6", "enum": ["consult", "light", "full"]},
    "owner": {"type": "string"},
    "active_agents": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
    "current_gate": {"type": ["string", "null"]},
    "next_action": {"type": "string"},

    "artifacts": {
      "oneOf": [
        {"type": "array", "minItems": 1, "items": {"type": "string"}},
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "target": {"type": "string"},
            "research": {"type": "string"},
            "analyses": {"type": "string"},
            "workspace": {"type": "string"},
            "durable_docs": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },

    "title": {"type": "string"},
    "objective": {"type": "string"},
    "requested_by": {"type": "string"},
    "project_root": {"type": "string"},
    "squad_root": {"type": "string"},
    "baseline": {"type": "string"},
    "status_note": {"type": "string"},
    "devops_id": {"type": ["string", "integer", "null"]},

    "constraints": {"type": "array", "items": {"type": "string"}},
    "open_conditions": {"type": "array", "items": {"type": "string"}},

    "personas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orchestrator": {"type": "string"},
        "active": {"type": "array", "items": {"type": "string"}},
        "research": {"type": "array", "items": {"type": "string"}},
        "pending": {"type": "array", "items": {"type": "string"}},
        "review_completed": {"type": "array", "items": {"type": "string"}}
      }
    },

    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "GT-entry": {"type": "string"},
        "GT-design-review": {"type": "string"},
        "GT-done": {"type": "string"},
        "G1": {"type": "string"},
        "G2": {"type": "string"},
        "G3": {"type": "string"},
        "G4": {"type": "string"},
        "G5": {"type": "string"},
        "G6": {"type": "string"},
        "G1-product": {"type": "string"},
        "G2-design": {"type": "string"},
        "G3-readiness": {"type": "string"},
        "G4-code-security": {"type": "string"},
        "G5-quality": {"type": "string"},
        "G6-governance-release": {"type": "string"}
      }
    },

    "decision_state": {"type": "object", "additionalProperties": {"type": "string"}},
    "reviews": {"type": "object", "additionalProperties": {"type": "string"}},

    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_prompt_tokens": {"type": "integer"},
        "total_completion_tokens": {"type": "integer"},
        "total_cost_usd": {"type": "number"},
        "total_steps": {"type": "integer"},
        "convergence_score": {"type": "number"}
      }
    },

    "updated_at": {"type": "string", "format": "date-time"},
    "phase_started_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
