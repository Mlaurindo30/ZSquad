{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-squad.local/contracts/task-template.schema.json",
  "title": "Governed task template",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "state", "enabled", "title", "owner_persona", "squad_id", "outcome", "inputs", "outputs", "method", "boundaries", "evidence_requirements", "failure_behavior", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["source", "adapt", "fuse", "reject", "proposed", "promoted"]},
    "enabled": {"type": "boolean"},
    "title": {"type": "string", "minLength": 2},
    "owner_persona": {"type": "string", "minLength": 2},
    "squad_id": {"type": "string", "minLength": 2},
    "outcome": {"type": "string", "minLength": 10},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "method": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "failure_behavior": {"type": "string", "minLength": 5},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["kind", "source_refs", "disposition_refs"], "properties": {"kind": {"enum": ["adapted", "generated", "native"]}, "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "disposition_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
  },
  "allOf": [{"if": {"properties": {"state": {"not": {"const": "promoted"}}}}, "then": {"properties": {"enabled": {"const": false}}}}]
}
