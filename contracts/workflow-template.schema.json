{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-squad.local/contracts/workflow-template.schema.json",
  "title": "Governed workflow template",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "state", "enabled", "title", "owner_persona", "squad_id", "type", "maximum_links", "inputs", "outputs", "steps", "recovery", "governance", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["source", "adapt", "fuse", "reject", "proposed", "promoted"]},
    "enabled": {"type": "boolean"},
    "title": {"type": "string", "minLength": 2},
    "owner_persona": {"type": "string", "minLength": 2},
    "squad_id": {"type": "string", "minLength": 2},
    "type": {"enum": ["sequential", "sequential-with-handoff"]},
    "maximum_links": {"type": "integer", "minimum": 1, "maximum": 5},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 25, "items": {"type": "object", "additionalProperties": false, "required": ["id", "owner_persona", "task_template", "depends_on", "condition", "checkpoint", "failure_route"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "owner_persona": {"type": "string", "minLength": 2}, "task_template": {"type": "string", "minLength": 2}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "condition": {"type": ["string", "null"]}, "checkpoint": {"type": "object", "additionalProperties": false, "required": ["criteria", "evidence_required"], "properties": {"criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}, "failure_route": {"enum": ["artifact-owner", "root-cause-owner", "blocked", "human"]}}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["checkpointed", "idempotent_resume", "rollback"], "properties": {"checkpointed": {"const": true}, "idempotent_resume": {"const": true}, "rollback": {"type": "string", "minLength": 5}}},
    "governance": {"type": "object", "additionalProperties": false, "required": ["gates", "author_cannot_approve_own_artifact", "human_approval_when_required"], "properties": {"gates": {"type": "array", "uniqueItems": true, "items": {"enum": ["G1-product", "G2-design", "G3-readiness", "G4-code-security", "G5-quality", "G6-governance-release"]}}, "author_cannot_approve_own_artifact": {"const": true}, "human_approval_when_required": {"const": true}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["kind", "source_refs", "disposition_refs"], "properties": {"kind": {"enum": ["adapted", "generated", "native"]}, "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "disposition_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
  },
  "allOf": [{"if": {"properties": {"state": {"not": {"const": "promoted"}}}}, "then": {"properties": {"enabled": {"const": false}}}}]
}
