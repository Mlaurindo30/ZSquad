{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_item", "verifier", "persona", "command", "exit_code", "passed", "timestamp", "file_hashes", "results"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item": {"type": "string", "pattern": "^(EPIC|US|TASK|BUG|REL|EVOL|STUDY|SPIKE|INCIDENT)-[A-Z0-9-]+$"},
    "verifier": {"type": "string", "minLength": 1},
    "persona": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "exit_code": {"type": "integer"},
    "passed": {"type": "boolean"},
    "timestamp": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "file_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "results": {"type": "object"},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"}
  }
}
